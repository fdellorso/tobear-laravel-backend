{
  "$schema": "https://opencode.ai/config.json",
  "share": "manual",
  "update": "auto",
  "watcher": {
    "ignore": ["vendor/**", "node_modules/**", "storage/**", "bootstrap/cache/**", ".git/**"]
  },
  "permissions": [
    {"action": "shell", "resource": "*", "effect": "allow"},
    {"action": "shell", "resource": "sudo *", "effect": "deny"},
    {"action": "shell", "resource": "rm -rf*", "effect": "ask"},
    {"action": "shell", "resource": "git push --force*", "effect": "deny"},
    {"action": "shell", "resource": "git push *", "effect": "ask"},
    {"action": "shell", "resource": "git reset --hard*", "effect": "ask"},
    {"action": "shell", "resource": "git clean*", "effect": "ask"},
    {"action": "edit", "resource": "*.env*", "effect": "ask"},
    {"action": "edit", "resource": "opencode.json", "effect": "ask"},
    {"action": "edit", "resource": ".opencode/*", "effect": "ask"},
    {"action": "edit", "resource": ".opencode/commands/*", "effect": "ask"},
    {"action": "edit", "resource": ".opencode/skills/*", "effect": "ask"},
    {"action": "external_directory", "resource": "*", "effect": "ask"}
  ],
  "lsp": {
    "php": {
      "command": ["npx", "intelephense", "--stdio"],
      "extensions": [".php"]
    }
  },
  "model": "opencode-go/mimo-v2.6-flash",
  "agents": {
    "plan": {
      "model": "opencode-go/mimo-v2.6-pro"
    }
  }
}
